// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// ★ ここを sqlite に変更しました
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ユーザー台帳の定義
model User {
  id             String   @id @default(cuid())
  userId         String   @unique // ClerkのユーザーID
  count          Int      @default(0) // 生成した回数
  isPremium      Boolean  @default(false) // 将来用：課金ユーザーフラグ
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}